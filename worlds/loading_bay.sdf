<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="loading_bay">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- ogre (1.x): ogre2 flickered in my VM -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Outer walls, 10 x 8 m -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
        <visual name="n"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry><material><ambient>0.25 0.4 0.65 1</ambient><diffuse>0.25 0.4 0.65 1</diffuse></material></visual>
        <collision name="s"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
        <visual name="s"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry><material><ambient>0.25 0.4 0.65 1</ambient><diffuse>0.25 0.4 0.65 1</diffuse></material></visual>
        <collision name="e"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
        <visual name="e"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry><material><ambient>0.25 0.4 0.65 1</ambient><diffuse>0.25 0.4 0.65 1</diffuse></material></visual>
        <collision name="w"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
        <visual name="w"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry><material><ambient>0.25 0.4 0.65 1</ambient><diffuse>0.25 0.4 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Cone slalom (staggered) -->
    <include><uri>model://traffic_cone</uri><name>slalom_1</name><pose>-3.0 -0.2 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>slalom_2</name><pose>-1.5 -1.0 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>slalom_3</name><pose>0.0 -0.2 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>slalom_4</name><pose>1.5 -1.0 0 0 0 0</pose></include>

    <!-- Cone cluster, bottom right -->
    <include><uri>model://traffic_cone</uri><name>cluster_1</name><pose>3.5 -2.0 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cluster_2</name><pose>3.9 -1.6 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cluster_3</name><pose>3.5 -1.2 0 0 0 0</pose></include>

    <!-- Pallet stack -->
    <model name="pallet_stack">
      <static>true</static>
      <pose>3.2 1.0 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 0.5</size></box></geometry>
          <material><ambient>0.5 0.33 0.18 1</ambient><diffuse>0.5 0.33 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Angled barrier -->
    <model name="barrier">
      <static>true</static>
      <pose>0.8 2.2 0.3 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.15 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.15 0.6</size></box></geometry>
          <material><ambient>0.85 0.15 0.12 1</ambient><diffuse>0.85 0.15 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pillar -->
    <model name="pillar">
      <static>true</static>
      <pose>-2.0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Crate -->
    <model name="crate">
      <static>true</static>
      <pose>-3.2 1.0 0.3 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.7 0.7 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.6</size></box></geometry>
          <material><ambient>0.78 0.62 0.4 1</ambient><diffuse>0.78 0.62 0.4 1</diffuse></material></visual>
      </link>
    </model>

  
    <model name="lane_n">
      <static>true</static>
      <pose>0 3.6 0.01 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>9.3 0.1 0.005</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
      </visual></link>
    </model>
    <model name="lane_s">
      <static>true</static>
      <pose>0 -3.6 0.01 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>9.3 0.1 0.005</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
      </visual></link>
    </model>
    <model name="lane_e">
      <static>true</static>
      <pose>4.6 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.1 7.3 0.005</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
      </visual></link>
    </model>
    <model name="lane_w">
      <static>true</static>
      <pose>-4.6 0 0.01 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.1 7.3 0.005</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
      </visual></link>
    </model>
</world>
</sdf>
